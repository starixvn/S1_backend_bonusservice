pipeline {
    agent none
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            environment {
                registry = '13.213.82.69/bonusservice/bonusservice'
            }
            steps {
                script {
                    env.imageversion = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -f ./BonusService/Dockerfile -t ${registry}:${imageversion} .'
                sh 'sudo docker push ${registry}:${imageversion}'
                sh 'sudo docker rmi ${registry}:${imageversion}'
            }
        }
        stage('Deploy') {
            agent { node { label 'Build' } }
            environment {
                pulumi_env = 'DEV'
                pulumi_project = 'BonusService'
                AWS_ACCESS_KEY_ID     = 'AKIA3CXJE5UPUBU2H3XE'
                AWS_SECRET_ACCESS_KEY = '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'
            }
            steps {
                dir('/jenkins/workspace/AWS.Deploy.FargateService/ECS-Service-Deploy/') {
                    sh 'pwd'
                    sh 'ls'
                    sh 'aws configure set aws_access_key_id ${AWS_ACCESS_KEY_ID}'
                    sh 'aws configure set aws_secret_access_key ${AWS_SECRET_ACCESS_KEY}'
                    sh 'aws configure set region ap-southeast-1'
                    sh 'aws configure set output json'
                    sh 'dotnet run -- ${pulumi_env} ${pulumi_project} ${imageversion} false'
                }
            }
        }
        stage('ArgoCD'){
            agent { node { label 'Build' } }
                steps{
                    dir('/jenkins/backend-manifest/dev-galaxy/leobet'){
                        sh 'git pull'
                        sh "yq -i '.spec.template.spec.containers[0].image = \"harbor.ailabpte.co/bonusservice/bonusservice:${imageversion}\"' bonusservice-deploy.yaml"
                        sh "yq -i '.spec.template.spec.containers[0].image = \"harbor.ailabpte.co/bonusservice/bonusservice:${imageversion}\"' bonusworker-deploy.yaml"
                        sh 'git add bonusservice-deploy.yaml'
                        sh 'git add bonusworker-deploy.yaml'
                        script {
                          status = sh (script: 'git status --short', returnStdout: true).trim()
                          if(!status.startsWith("??")){
                              sh "git commit -m 'update dev bonusservice ver:${imageversion}'"
                              sh 'git push'
                          }
                        }
                    }
                }
        }
    }
}



