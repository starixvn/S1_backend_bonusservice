{
  "Urls": "http://*:5000",
  "ServiceType": "worker",
  "Environment": "LOCAL",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "Name": "WorkerFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/bonus/bonus-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "Worker running at: {time}",
    "Executing {ObjectResultType}, writing value of type '{Type}'."
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "Sentry": {
    "Dsn": "https://48a9ac90790cc8267250b8f2fd4ad824@sentry-s1.nexentgame.com/14",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Warning",
    "AttachStackTrace": true,
    "Debug": true,
    "DiagnosticLevel": "Error",
    "TracesSampleRate": 1.0
  },

  "ConfigService": [ "http://ne_s1_config_service_LOCAL:5000/" ],
  "OpenSearch": {
    "Uri": "logstash.nexdev.net",
    "Port": 31853
  },
  "ServiceName": "Bonus service"
}
